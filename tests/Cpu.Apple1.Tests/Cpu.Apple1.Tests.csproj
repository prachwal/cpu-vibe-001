  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\src\Cpu.Apple1\profiles\**\*.json" CopyToOutputDirectory="PreserveNewest" Link="profiles\%(RecursiveDir)%(Filename)%(Extension)" />
