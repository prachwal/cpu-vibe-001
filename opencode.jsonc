{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/mimo-v2.5",
  "small_model": "opencode-go/deepseek-v4-flash",
  "default_agent": "build",
  "shell": "/bin/bash",
  "logLevel": "INFO",
  "autoupdate": "notify",
  "snapshot": true,
  "instructions": ["AGENTS.md"],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "permission": {
    "edit": "ask",
    "bash": { 
      "git *": "allow", 
      "*": "ask" 
    },
    "external_directory": { 
      "~/secrets/**": "deny", 
      "*": "allow" 
    }
  },
  "formatter": false,
  "lsp": true,
  "compaction": { "auto": true, "tail_turns": 15 }
}